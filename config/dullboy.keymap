#if 1
car {
  label = "Car";
  bindings = <
    &dead_circ_spc   &kp LESS_THAN     &kp GREATER_THAN    &kp DOLLAR     &kp PERCENT   &kp AT    &kp AMPERSAND           &kp ASTERISK   &kp APOSTROPHE  &dead_grave_spc
    &kp LEFT_BRACE      &kp LEFT_PARENTHESIS   &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE    &kp EQUAL   &kp BACKSLASH  &kp PLUS           &kp MINUS   &kp SLASH  &kp DOUBLE_QUOTES
    &dead_tild_spc   &kp LEFT_BRACKET   &kp RIGHT_BRACKET  &kp UNDERSCORE     &nav_hash_at   &kp PIPE  &kp EXCLAMATION           &kp SEMICOLON   &kp COLON   &kp QUESTION
    &none            &none         &nbsp        &trans &pmil  TEXT_DEG  &trans &nbsp        &none        &none
  >;
};
