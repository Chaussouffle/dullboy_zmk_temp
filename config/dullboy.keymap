#if 1
ms {
  label = "Mouse";
  bindings = <
    &none  &kp LC(PG_UP)        &kp LC(W)          &kp LC(PG_DN)       &msc SCRL_UP    &msc SCRL_UP    &kp LC(PG_UP)       &mmv MOVE_Y(-1100)  &kp LC(PG_DN)        &none
    &none  &lt SCROLL_ACCEL ESC &ht_kpmkp_b230w LCTRL RCLK &mkp LCLK           &msc SCRL_DOWN  &mkp LCLK  &mmv MOVE_X(-1400)       &mmv MOVE_Y(1100)   &mmv MOVE_X(1400)    &ht_kpmkp_b230w LCTRL RCLK
    &none  &kp LC(A)            &kp LC(C)          &kp LC(V)          &kp PRINTSCREEN &msc SCRL_DOWN  &msc SCRL_LEFT      &copypaste          &msc SCRL_RIGHT      &none
    &none  &none                &ht_moenda_h150 ACC 0   &mt RIGHT_SHIFT DEL &ht_momm_h150 NAV 0          &trans          &mt RIGHT_SHIFT DEL &trans              &none                &none
  >;
};
