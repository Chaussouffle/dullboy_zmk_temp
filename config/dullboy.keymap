ms_prime {
  label = "Mouse_prime";
  bindings = <
    &none  &kp LC(PG_UP)  &mmv MOVE_Y(-1100)   &kp LC(PG_DN)   &msc SCRL_UP    &msc SCRL_UP    &kp LC(PG_UP)  &kp LC(W)          &kp LC(PG_DN)        &none
   &ht_kpmkp_b230w LCTRL RCLK  &mmv MOVE_X(-1400) &mmv MOVE_Y(1100) &mmv MOVE_X(1400) &mkp LCLK  &msc SCRL_DOWN  &mkp LCLK      &ht_kpmkp_b230w LCTRL RCLK &lt SCROLL_ACCEL ESC &none
    &none  &msc SCRL_LEFT &copypaste     &msc SCRL_RIGHT &msc SCRL_DOWN &kp PRINTSCREEN &kp LC(V)       &kp LC(C)         &kp LC(A)      &none
