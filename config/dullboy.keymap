#include <behaviors.dtsi>
#include "layout.h"
#include "layers.h"
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>
#define ZMK_POINTING_DEFAULT_SCRL_VAL 15
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/bt.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/* Index de layers : définis dans layers.h (inclus ci-dessus),
 * donc disponibles aussi dans combos.dtsi et dullboy_behaviors.dtsi. */
#include "macros.dtsi"
#include "combos.dtsi"

#include "dullboy_behaviors.dtsi"

&lt {
    flavor = "hold-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <0>;
};

&mt {
    tapping-term-ms = <150>;
};

&sl {
    release-after-ms = <300>;
};

&mmv {
    time-to-max-speed-ms = <400>;
    acceleration-exponent = <2>;
};

/ {

  /* --- Scroll accel via input processor --- */
  scroll_scaler: scroll_scaler {
    compatible = "zmk,input-processor-scaler";
    #input-processor-cells = <2>;
    type = <INPUT_EV_REL>;
    codes = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
    track-remainders;
  };

keymap {
  compatible = "zmk,keymap";

  /* --- Base layer selection -------------------------------------------------
   * Change exactly one block from '#if 0' to '#if 1'.
   * Only one base layer must be active at a time.
   *
   * Active choices:
   *   - QWERTY
   *   - COLEMAK
   *   - WORKMAN
   *   - DVORAK
   *   - ERGOL
   *
   * The active base layer should also be reflected in any related define
   * elsewhere in the file if your configuration uses one.
   * ------------------------------------------------------------------------ */

#if 0 // QWERTY
base_qwerty {
  label = "Base";
  bindings = <
    &kp Q       &kp W      &kp E              &kp R             &kp T                 &kp Y          &kp U                 &kp I       &kp O       &kp P
    &ht_mokp_b220 MS A &ht_kpkp_b220_l LGUI S &ht_kpkp_b220_l LCTRL D    &ht_kpkp_b220_l LALT F      &lt CAR G             &lt CAR H      &ht_kpkp_b220_r LALT J          &ht_kpkp_b220_r LCTRL K &ht_kpkp_b220_r LGUI L  &ht_mokp_b220 MS SEMI
    &kp Z       &kp X      &sl ACC     &kp C             &kp V                 &kp B          &kp N                 &kp M       &kp COMMA   &kp PERIOD
    &none       &none      &lt FL SPACE       &lt NAV BACKSPACE &mt RIGHT_SHIFT ENTER &lt NAV ENTER  &mt RIGHT_SHIFT SPACE &lt FL TAB  &none       &none
  >;
};
#endif

#if 0 // COLEMAK
base_colemak {
  label = "Base";
  bindings = <
    &kp Q       &kp W      &kp F              &kp P             &kp G                 &kp J          &kp L                 &kp U       &kp Y       &kp SEMI
    &ht_mokp_b220 MS A &ht_kpkp_b220_l LGUI R &ht_kpkp_b220_l LCTRL S    &ht_kpkp_b220_l LALT T      &lt CAR D             &lt CAR H      &ht_kpkp_b220_r LALT N          &ht_kpkp_b220_r LCTRL E &ht_kpkp_b220_r LGUI I  &ht_mokp_b220 MS O
    &kp Z       &kp X      &sl ACC     &kp C             &kp V                 &kp B          &kp K                 &kp M       &kp COMMA   &kp PERIOD
    &none       &none      &lt FL SPACE       &lt NAV BACKSPACE &mt RIGHT_SHIFT ENTER &lt NAV ENTER  &mt RIGHT_SHIFT SPACE &lt FL TAB  &none       &none
  >;
};
#endif

#if 0 // WORKMAN
base_workman {
  label = "Base";
  bindings = <
    &kp Q       &kp D      &kp R              &kp W             &kp B                 &kp J          &kp F                 &kp U       &kp P       &kp SEMI
    &ht_mokp_b220 MS A &ht_kpkp_b220_l LGUI S &ht_kpkp_b220_l LCTRL H    &ht_kpkp_b220_l LALT T      &lt CAR G             &lt CAR Y      &ht_kpkp_b220_r LALT N          &ht_kpkp_b220_r LCTRL E &ht_kpkp_b220_r LGUI O  &ht_mokp_b220 MS I
    &kp Z       &kp X      &sl ACC     &kp M             &kp C                 &kp V          &kp K                 &kp L       &kp COMMA   &kp PERIOD
    &none       &none      &lt FL SPACE       &lt NAV BACKSPACE &mt RIGHT_SHIFT ENTER &lt NAV ENTER  &mt RIGHT_SHIFT SPACE &lt FL TAB  &none       &none
  >;
};
#endif

#if 0 // DVORAK
base_dvorak {
  label = "Base";
  bindings = <
    &kp APOSTROPHE &kp COMMA  &kp PERIOD         &kp P             &kp Y                 &kp F          &kp G                 &kp C       &kp R       &kp L
    &ht_mokp_b220 MS A &ht_kpkp_b220_l LGUI O &ht_kpkp_b220_l LCTRL E    &ht_kpkp_b220_l LALT U      &lt CAR I             &lt CAR D      &ht_kpkp_b220_r LALT H          &ht_kpkp_b220_r LCTRL T &ht_kpkp_b220_r LGUI N  &ht_mokp_b220 MS S
    &kp SEMI    &kp Q      &sl ACC     &kp J             &kp K                 &kp X          &kp B                 &kp M       &kp W       &kp V
    &none       &none      &lt FL SPACE       &lt NAV BACKSPACE &mt RIGHT_SHIFT ENTER &lt NAV ENTER  &mt RIGHT_SHIFT SPACE &lt FL TAB  &none       &none
  >;
};
#endif

#if 1 // ERGOL
base_ergol {
  label = "Base";
  bindings = <
    &kp Q       &kp C      &kp O           &kp P      &kp W           &kp J           &kp M      &kp D       &ht_mosl_b220 ACC ACC &kp Z
    &ht_mokp_b220 MS A &ht_kpkp_b220_l LGUI S &ht_kpkp_b220_l LCTRL E &ht_kpkp_b220_l LALT N &ht_kpkp_b220_l LC(RSHFT) F &ht_kpkp_b220_r LC(RSHFT) L &ht_kpkp_b220_r LALT R &ht_kpkp_b220_r LCTRL T &ht_kpkp_b220_r LGUI I &ht_mokp_b220 MS_PRIME U
    &ht_mokp_b220 MS_PRIME Y       &kp X      &backctrl &kp V      &kp B           &kp PERIOD      &kp H      &kp G       &kp COMMA       &ht_mokp_b220 MS K
    &none       &none      &lt FL TAB      &ht_mosl_b220 NAV CAR &ht_mokp_h180 NAV_PRIME ENTER &ht_mokp_h180 NAV_PRIME ENTER &ht_mmmm_h200i10 0 0 &lt FL TAB &none &none
  >;
};
#endif

#if 1
nav {
  label = "Nav";
  bindings = <
    &ht_kpkp_b220_l LGUI ESC      &home_with_ctrl_gui    &kp UP     &end_with_ctrl_gui    &kp PG_UP           &nav_hash_at    &nav_7_ampr      &nav_8_ast  &nav_9_apos  &nav_pct_grave
    &ctrl_senter_td                &kp LEFT                &kp DOWN   &kp RIGHT             &ht_kpmm_h150 LC(LGUI) 0    &nav_com_bslh   &nav_4_plus      &nav_5_min  &nav_6_slsh  &nav_0_dquo
    &kp LEFT_ALT                   &kp F2                  &kp F4     &kp TAB               &kp PG_DN           &nav_dot_pipe   &nav_1_excl      &nav_2_sem   &nav_3_col   &nav_eql_ques
&none  &none  &ht_momm_t70 MS_PRIME 0  &trans  &trans  &trans  &mt RSHIFT SPACE  &lt MS_PRIME TAB  &none  &none  >;
};
#endif

#if 1
nav_prime {
  label = "Nav_prime";
  bindings = <
    &nav_pct_grave  &nav_7_ampr  &nav_8_ast  &nav_9_apos       &nav_hash_at    &kp PG_UP        &home_with_ctrl_gui       &kp UP       &end_with_ctrl_gui  &ht_kpkp_b220_l LGUI ESC
    &nav_0_dquo     &nav_4_plus  &nav_5_min  &nav_6_slsh       &nav_com_bslh   &ht_kpmm_h150 LC(LGUI) 0 &kp LEFT     &kp DOWN     &kp RIGHT           &ctrl_senter_td
    &nav_eql_ques   &nav_1_excl  &nav_2_sem  &nav_3_col        &nav_dot_pipe   &kp PG_DN        &kp TAB                   &kp F4       &kp F2              &mt LEFT_ALT LS(ENTER)
    &none           &none        &lt MS TAB &mt RSHIFT SPACE &trans         &trans           &mt RSHIFT SPACE          &ht_momm_t70 MS_PRIME 0 &none &none
  >;
};
