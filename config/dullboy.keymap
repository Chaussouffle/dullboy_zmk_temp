#if 1
acc {
  label = "Acc";
  bindings = <
    &a_circ_minmaj   &cced_minmaj    &o_circ_minmaj   &o_dier_minmaj  &oe_minmaj       &at_ss      &i_dier_minmaj   &i_circ_minmaj TEXT_DEG      &u_circ_minmaj
    &a_grav_minmaj   &e_acut_minmaj  &e_grav_minmaj   &e_circ_minmaj  &e_dier_minmaj   &os_dotm    &und_os          &kp MINUS     &u_dier_minmaj  &u_grav_minmaj
    &a_dier_minmaj   &laq            &raq             &endash         &emd             ACC_TILDE ACC_ACUTE      ACC_GRAVE    ACC_CIRC     ACC_DIAERESIS
    &none            &none           &nbsp            &sk RIGHT_SHIFT &trans       TEXT_DEG      &ht_mokp_b250w MAJACC APOSTROPHE     &nbsp          &none           &none
  >;
