#if 1
majacc {
  label = "MajAcc";
  bindings = <
    &a_circ_caps     &S_Cc           &o_circ_caps     &o_dier_caps    &S_OE           &ss        &i_dier_caps     &i_circ_caps    TEXT_DEG   &u_circ_caps
    &a_grav_caps     &e_acut_caps    &e_grav_caps     &e_circ_caps    &e_dier_caps    &dotm      &S_Os            &kp MINUS      &u_dier_caps &u_grav_caps
    &a_dier_caps     &laq            &raq             &endash         &emd            ACC_TILDE ACC_ACUTE      ACC_GRAVE    ACC_CIRC  ACC_DIAERESIS
    &none            &none           &nbsp            &sk RIGHT_SHIFT &in             TEXT_DEG     &kp APOSTROPHE &nbsp          &none          &none
  >;
