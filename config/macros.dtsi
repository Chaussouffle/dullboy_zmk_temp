    u_dier: u_dier {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      wait-ms = <0>;
      tap-ms = <0>;
      bindings = <&macro_tap &kp CH_DDIA &kp U>;
    };

    u_dier_caps: u_dier_caps {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      wait-ms = <0>;
      tap-ms = <0>;
      bindings = <&macro_tap &kp CH_DDIA &kp LS(U)>;
    };

    u_circ: u_circ {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      wait-ms = <0>;
      tap-ms = <0>;
      bindings = <&macro_tap &kp CH_DCIR &kp U>;
    };

    u_circ_caps: u_circ_caps {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      wait-ms = <0>;
      tap-ms = <0>;
      bindings = <&macro_tap &kp CH_DCIR &kp LS(U)>;
    };

    /* =========================
     * ALT-numpad (Windows)
     * ========================= */

    S_Cc: S_Cc {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      wait-ms = <0>;
      tap-ms = <0>;
      bindings = <
        &macro_press &kp LEFT_ALT
        &macro_tap &kp KP_NUMBER_0 &kp KP_NUMBER_1 &kp KP_NUMBER_9 &kp KP_NUMBER_9
        &macro_release &kp LEFT_ALT
      >;
    };

    S_Os: S_Os {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      wait-ms = <0>;
      tap-ms = <0>;
      bindings = <
        &macro_press &kp LEFT_ALT
        &macro_tap &kp KP_NUMBER_0 &kp KP_NUMBER_2 &kp KP_NUMBER_1 &kp KP_NUMBER_6
        &macro_release &kp LEFT_ALT
      >;
    };

    S_OE: S_OE {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      wait-ms = <0>;
      tap-ms = <0>;
      bindings = <
        &macro_press &kp LEFT_ALT
        &macro_tap &kp KP_NUMBER_0 &kp KP_NUMBER_1 &kp KP_NUMBER_4 &kp KP_NUMBER_0
        &macro_release &kp LEFT_ALT
      >;
    };

    oe: oe {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      wait-ms = <0>;
      tap-ms = <0>;
      bindings = <
        &macro_press &kp LEFT_ALT
        &macro_tap &kp KP_NUMBER_0 &kp KP_NUMBER_1 &kp KP_NUMBER_5 &kp KP_NUMBER_6
        &macro_release &kp LEFT_ALT
